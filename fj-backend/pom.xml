<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ===== 父 POM：飞检现场管理系统后端 ===== -->
    <groupId>com.fj</groupId>
    <artifactId>fj-backend</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>fj-backend</name>
    <description>飞检现场管理系统 — 后端 Maven 多模块聚合</description>

    <!-- ===== 子模块（12 个，见设计文档 §2.2） ===== -->
    <modules>
        <module>fj-common</module>
        <module>fj-auth</module>
        <module>fj-system</module>
        <module>fj-project</module>
        <module>fj-inspection</module>
        <module>fj-issue</module>
        <module>fj-report</module>
        <module>fj-approval</module>
        <module>fj-export</module>
        <module>fj-sync</module>
        <module>fj-recommend</module>
        <module>fj-api</module>
    </modules>

    <!-- ===== 技术栈版本统一管理 ===== -->
    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Spring Boot 3.2+ -->
        <spring-boot.version>3.2.5</spring-boot.version>

        <!-- 数据库 -->
        <postgresql.version>42.7.3</postgresql.version>
        <flyway.version>9.22.3</flyway.version>

        <!-- 缓存 -->
        <caffeine.version>3.1.8</caffeine.version>

        <!-- JWT -->
        <jjwt.version>0.12.5</jjwt.version>

        <!-- 工具库 -->
        <lombok.version>1.18.32</lombok.version>

        <!-- 测试 -->
        <junit.version>5.10.2</junit.version>
        <h2.version>2.2.224</h2.version>
    </properties>

    <!-- ===== 依赖版本集中声明（子模块引用不写 version） ===== -->
    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot BOM 统一管理 Spring 全家桶版本 -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 内部模块互相引用 -->
            <dependency>
                <groupId>com.fj</groupId>
                <artifactId>fj-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fj</groupId>
                <artifactId>fj-system</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fj</groupId>
                <artifactId>fj-auth</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fj</groupId>
                <artifactId>fj-project</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fj</groupId>
                <artifactId>fj-inspection</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fj</groupId>
                <artifactId>fj-issue</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fj</groupId>
                <artifactId>fj-report</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fj</groupId>
                <artifactId>fj-approval</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fj</groupId>
                <artifactId>fj-export</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fj</groupId>
                <artifactId>fj-sync</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fj</groupId>
                <artifactId>fj-recommend</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- 第三方依赖版本锁定 -->
            <dependency>
                <groupId>com.github.ben-manes.caffeine</groupId>
                <artifactId>caffeine</artifactId>
                <version>${caffeine.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- ===== 所有子模块共享依赖 ===== -->
    <dependencies>
        <!-- Lombok（编译期，非传递） -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- 测试基础（所有模块统一 JUnit 5） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <source>${java.version}</source>
                        <target>${java.version}</target>
                        <encoding>UTF-8</encoding>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>
